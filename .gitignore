# ── Secrets & environment ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/

# ── Node / Next.js ────────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*

# ── Runtime data: user documents, vectors, databases ─────────────────
backend/data/
*.sqlite
*.sqlite3
*.db
*.db-journal
qdrant_storage/

# PDFs are user documents. Only fictional fixtures/samples are tracked.
*.pdf
!backend/tests/fixtures/*.pdf
!examples/*.pdf
!frontend/public/samples/*.pdf

# ── Audio, transcripts, recordings ────────────────────────────────────
*.wav
*.mp3
*.ogg
*.webm
!frontend/public/media/*.webm
*.flac
recordings/
transcripts/

# ── Models, caches, downloaded binaries ───────────────────────────────
models/
.cache/
hf_cache/
*.onnx
*.onnx.json
*.safetensors
tools/

# ── Logs & temp ───────────────────────────────────────────────────────
logs/
*.log
tmp/
*.tmp

# ── Test & docs artifacts ─────────────────────────────────────────────
playwright-report/
test-results/
blob-report/
frontend/coverage/
site/
evaluations/results/*.local.json

# ── IDE / OS ──────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
