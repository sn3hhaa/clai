# Copy to backend/.env. Never commit .env. Every value is optional; defaults shown.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Comma-separated browser origins allowed by CORS.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Where SQLite, uploaded PDFs, BM25 indexes and local Qdrant data live.
DATA_DIR=./data
MAX_UPLOAD_MB=20
MAX_PAGES=300

# ── LLM (OpenRouter). Leave the key empty to use extractive answers only.
# Free models are rate-limited (20/min, 50/day without purchased credits).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_TIMEOUT_S=30

# ── Qdrant: local (embedded, default) | remote (native server or Qdrant Cloud) | memory
QDRANT_MODE=local
QDRANT_PATH=
QDRANT_URL=
QDRANT_API_KEY=

# ── LiveKit. Defaults match `livekit-server --dev` (local, no account needed).
# For LiveKit Cloud (free Build plan) use your project's wss:// URL, key and secret.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── Voice providers: whisper|gradium and piper|gradium
STT_PROVIDER=whisper
TTS_PROVIDER=piper
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=
WHISPER_MODEL=base.en
PIPER_VOICE=en_US-lessac-medium

# The voice worker reaches the API here.
API_INTERNAL_URL=http://127.0.0.1:8000
